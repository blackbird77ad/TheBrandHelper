# Frontend. VITE_ variables are exposed to the browser bundle.
# Do not put private server-only secrets here.
VITE_API_URL=https://thebrandhelper.onrender.com
VITE_ADMIN_SECRET=
VITE_APPS_SCRIPT_URL=
VITE_CONTACT_APPS_SCRIPT_URL=
VITE_BLUEPRINT_APPS_SCRIPT_URL=

# Backend only. Set these in BACKEND/.env or your host environment.
PORT=4000
NODE_ENV=production
MONGODB_URI=
MONGODB_DB_NAME=thebrandhelperdb
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
MONGODB_MAX_POOL_SIZE=10
MONGODB_MIN_POOL_SIZE=0
MONGODB_MAX_IDLE_TIME_MS=30000
DB_WRITE_TIMEOUT_MS=15000
ADMIN_SECRET=
ADMIN_EMAILS=blackbird77ad@gmail.com,davida@thebrandhelper.com
ADMIN_RESET_NOTIFY_EMAILS=blackbird77ad@gmail.com,davida@thebrandhelper.com
ADMIN_NOTIFY_EMAILS=blackbird77ad@gmail.com,davida@thebrandhelper.com
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=
ADMIN_MASTER_PIN=
RESEND_API_KEY=
RESEND_FROM_EMAIL=The BrandHelper <notifications@thebrandhelper.com>
ALLOWED_ORIGINS=https://thebrandhelper.com,https://www.thebrandhelper.com
ALLOW_LOCAL_ORIGINS=true
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_MAX_UPLOAD_MB=8
